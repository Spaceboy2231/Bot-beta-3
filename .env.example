# ==================== TELEGRAM BOT CONFIG ====================
# Get these from https://my.telegram.org/apps
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Get this from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Your Telegram numeric user ID (from @userinfobot)
ADMIN_ID=your_telegram_id_here

# Comma-separated list of additional admin IDs
KEY_ADMINS=id1,id2,id3

# Your Telegram channel username (without @)
CHANNEL_USERNAME=THENETWORKOFLEO

# Photo URL for bot start message
PHOTO_URL=https://i.postimg.cc/NMfk3jpP/Leo4youh.png

# Razorpay config
RAZORPAY_FIXED_SITE=https://pages.razorpay.com/YOUR_SITE_LINK
RAZORPAY_API_BASE=https://auto-razorpay-nano.vercel.app/hit
RAZORPAY_API_KEY=aiojames
